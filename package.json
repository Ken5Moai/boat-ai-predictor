{
  "name": "boat-ai-predictor",
  "private": true,
  "description": "競艇AI予想ツール。index.html 単体で動くので、ここの依存はテストと検証のためだけに使う。",
  "scripts": {
    "test": "node tests/run.js",
    "backtest": "node backtest.js",
    "probe": "node vote-assist.js --probe",
    "plan": "node vote-assist.js tmp/plan.json --dry",
    "sample": "node vote-assist.js --sample",
    "today": "node auto.js --plan",
    "go": "node auto.js --max 10 --fill --stop-loss 5000",
    "record": "node record.js",
    "figures": "node sync-figures.js"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "playwright": "^1.56.1"
  }
}
